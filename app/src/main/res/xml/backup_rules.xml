<?xml version="1.0" encoding="utf-8"?>
<!-- Android backup (Android 11 and older): keep the diary, skip the city database, which can be rebuilt. -->
<full-backup-content>
    <exclude domain="database" path="cities.db" />
    <exclude domain="database" path="cities.db-shm" />
    <exclude domain="database" path="cities.db-wal" />
</full-backup-content>
